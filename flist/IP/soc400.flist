#-----------------------------------------------------------------------------
# Arm CoreSight SoC-400 debug subsystem
#
# The content under $SOCLABS_SOC400_DIR is produced by
#   millisoc_tech/tools/build_soc400.sh   (make target: build_soc400)
# which copies the static RTL out of the Arm IP delivery and renders the
# configurable components from their IP-XACT.
#
# Nothing in this list is hand maintained Arm source; it is all either
# copied verbatim or generated.  See millisoc_tech/.gitignore.
#-----------------------------------------------------------------------------

# -- Generic cells -----------------------------------------------------------
$(SOCLABS_SOC400_DIR)/static/models/cells/generic/cx_cdc_corrupt_gry.v
