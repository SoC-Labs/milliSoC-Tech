// -----------------------------------------------------------------------------
//  Purpose : Olympus execution_tb verilog command file.
// -----------------------------------------------------------------------------

// ============= Verilog library extensions ===========
+libext+.sv+.vlib

// ============= Include file search path =============


// Cells
+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cdc_comb_and2.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cdc_comb_mux4.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cdc_connect.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_and_gate.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_cdc_and.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_cdc_or2.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_flop.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_inter_clkgate.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_semi_sync_flop.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_sync.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic/olympus_cell_xor2.sv

// OLYMPUS_CONFIG.v
+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/olympus/verilog


+libext+.v+.sv+.vlib

$(CORTEX_M85_LOGICAL_DIR)/logical/shared/verilog/olympus_instrid_pkg.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/olympus_core/verilog/olympus_core_instrid.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/olympus_epu/verilog/olympus_epu_instrid.sv

$(CORTEX_M85_LOGICAL_DIR)/logical/olympus/verilog/olympus_tarmac.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/olympus/verilog/olympus_tarmac_inst.sv

