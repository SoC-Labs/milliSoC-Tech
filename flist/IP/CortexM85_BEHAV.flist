// -----------------------------------------------------------------------------
//  Purpose : Olympus execution_tb verilog command file.
// -----------------------------------------------------------------------------

// ============= Verilog library extensions ===========
+libext+.sv+.vlib

// ============= Include file search path =============

// +incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/testbench/execution_tb/verilog
// -y      $(CORTEX_M85_LOGICAL_DIR)/logical/testbench/execution_tb/verilog

// +incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/testbench/execution_tb/verilog/example_sys
// -y      $(CORTEX_M85_LOGICAL_DIR)/logical/testbench/execution_tb/verilog/example_sys

+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/testbench/execution_tb/verilog/models
-y      $(CORTEX_M85_LOGICAL_DIR)/logical/testbench/execution_tb/verilog/models

+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic
-y      $(CORTEX_M85_LOGICAL_DIR)/logical/models/cells/generic

// OLYMPUS_CONFIG.v
+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/olympus/verilog

// MCU layer
+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/olympus_aab/verilog
-y      $(CORTEX_M85_LOGICAL_DIR)/logical/olympus_aab/verilog


+libext+.v+.sv+.vlib

$(CORTEX_M85_LOGICAL_DIR)/logical/shared/verilog/olympus_instrid_pkg.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/olympus_core/verilog/olympus_core_instrid.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/olympus_epu/verilog/olympus_epu_instrid.sv

$(CORTEX_M85_LOGICAL_DIR)/logical/olympus/verilog/olympus_tarmac.sv
$(CORTEX_M85_LOGICAL_DIR)/logical/olympus/verilog/olympus_tarmac_inst.sv

+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/shared/verilog
-y $(CORTEX_M85_LOGICAL_DIR)/logical/shared/verilog

+incdir+$(CORTEX_M85_LOGICAL_DIR)/logical/testbench/shared/tarmac/verilog
-y      $(CORTEX_M85_LOGICAL_DIR)/logical/testbench/shared/tarmac/verilog




