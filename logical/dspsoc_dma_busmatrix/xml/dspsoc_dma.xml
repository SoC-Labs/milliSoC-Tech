<!--  Purpose             : based on Example XML file, defining an interconnect for     -->
<!--                        (was 2 AHB Masters and 3 AHB Slaves.)                       -->
<!--                         4 AHB Managers and 8 AHB Subordinates                      -->
<!--                                                                                    -->
<!--  Note                : This information will overwrite parameters                  -->
<!--                         specified on the command line                              -->
<!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  -->

<cfgfile>

  <!-- - - - - *** DO NOT MODIFY ABOVE THIS LINE *** - - - - - - - - - - -  -->

  <!-- Global definitions -->

  <architecture_version>ahb2</architecture_version>
  <arbitration_scheme>burst</arbitration_scheme>
  <routing_data_width>32</routing_data_width>
  <routing_address_width>32</routing_address_width>
  <user_signal_width>0</user_signal_width>
  <bus_matrix_name>dspsoc_dma_busmatrix</bus_matrix_name>
  <input_stage_name>dspsoc_dma_inititator_input</input_stage_name>
  <matrix_decode_name>dspsoc_dma_matrix_decode</matrix_decode_name>
  <output_arbiter_name>dspsoc_dma_arbiter</output_arbiter_name>
  <output_stage_name>dspsoc_dma_target_output< /output_stage_name>


  <!-- Slave interface definitions -->

  <slave_interface name="_DMAC_0">
    <sparse_connect interface="_M7_AHBS"/>
    <sparse_connect interface="_SYS_BUS"/>
    <address_region interface="_M7_AHBS" mem_lo='00000000' mem_hi='3fffffff' remapping='none'/>
    <address_region interface="_SYS_BUS" mem_lo='40000000' mem_hi='ffffffff' remapping='none'/>
  </slave_interface>

  <!-- Master interface definitions -->

  <master_interface name="_M7_AHBS"/>
  <master_interface name="_SYS_BUS"/>

  <!-- - - - - *** DO NOT MODIFY BELOW THIS LINE *** - - - - - - - - - - - -->

</cfgfile>
